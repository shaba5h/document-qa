# Local CLI configuration for document-qa.
#
# Settings use the DQA_ prefix and "__" for nested fields.
# Copy this file to .env and fill in the values you need.

# --- Chat model (required for `document-qa ask`) ---

DQA_CHATMODEL__API_KEY=your_openrouter_api_key_here
DQA_CHATMODEL__MODEL_NAME=openai/gpt-4o-mini
# DQA_CHATMODEL__TEMPERATURE=0.2

# --- Embeddings ---

# DQA_EMBEDDER__MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# DQA_EMBEDDER__BATCH_SIZE=1
# DQA_EMBEDDER__DOCUMENTS_ENCODE_PROMPT_NAME=
# DQA_EMBEDDER__QUERY_ENCODE_PROMPT_NAME=

# --- Local knowledge base ---

# DQA_KNOWLEDGE_BASE__PATH=.data/lance
# DQA_KNOWLEDGE_BASE__TABLE_NAME=documents

# --- Chunking ---

# DQA_CHUNKING__MAX_TOKENS=500

# --- Retrieval ---

# DQA_RETRIEVAL__K=10
# DQA_RETRIEVAL__VECTOR_WEIGHT=0.5
# DQA_RETRIEVAL__FTS_WEIGHT=0.5

# --- Telegram bot (required for `document-qa-telegram`) ---

# DQA_TELEGRAM__BOT_TOKEN=your_telegram_bot_token_here
