{
  "schema_version": 1,
  "name": "synthetic-company-policies-v1",
  "description": "A reproducible evidence-level RAG benchmark with numeric hard negatives, multi-source questions, and unanswerable cases.",
  "pipeline": {
    "embedder_model": "sentence-transformers/all-MiniLM-L6-v2",
    "documents_prompt_name": "document",
    "query_prompt_name": "query",
    "chunk_max_tokens": 500,
    "retrieval_k": 3,
    "vector_weight": 0.5,
    "fts_weight": 0.5,
    "generation_temperature": 0.0
  },
  "corpus": [
    "corpus/returns-policy.md",
    "corpus/shipping-policy.md",
    "corpus/employee-handbook.md",
    "corpus/support-guide.md",
    "corpus/security-operations.md",
    "corpus/subscription-policy.md"
  ],
  "cases": [
