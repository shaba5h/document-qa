      "expected_evidence": [
        {"source_filename": "returns-policy.md", "section_path": ["Product Returns and Exchanges", "Product Returns"]}
      ],
      "expected_facts": ["30 calendar days"],
      "fact_aliases": {"30 calendar days": ["30 days"]},
      "tags": ["single-source", "numeric", "hard-negative"]
    },
